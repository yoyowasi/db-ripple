<Project Sdk="Microsoft.NET.Sdk">

  <!--
    2주차 공용 테스트 지원(DB 격리 규칙 dbrt_<컴포넌트>_). 테스트 프로젝트가 아니라 클래스 라이브러리다.
    구현자는 고치지 않는다(바꿀 일이 생기면 오케스트레이터에 보고). tests/DbRipple.Core.Tests/SqlTestSupport.cs(dbr_it_)를 바탕으로 했다.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.extensibility.core" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbRipple.Core\DbRipple.Core.csproj" />
    <ProjectReference Include="..\..\src\DbRipple.Contracts\DbRipple.Contracts.csproj" />
  </ItemGroup>

</Project>
