        "definition": "\nCREATE TRIGGER cl08.trg_Acct_upd ON cl08.Acct AFTER UPDATE AS\nBEGIN\n    SET NOCOUNT ON;\n    IF NOT EXISTS (SELECT 1 FROM inserted WHERE touched < 3) RETURN;\n    UPDATE a\n    SET touched = a.touched + 1\n    FROM cl08.Acct AS a\n    INNER JOIN inserted AS i ON a.id = i.id\n    WHERE i.touched < 3;\nEND;\n",
