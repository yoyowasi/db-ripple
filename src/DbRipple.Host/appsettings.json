{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "127.0.0.1;localhost;[::1]",
  "DbRipple": {
    "Urls": "http://127.0.0.1:5080",
    "Mode": "SingleServer",
    "OriginDb": "AW_Origin",
    "SandboxDb": "AW_Sandbox",
    "SnapshotDb": "AW_Sandbox_base",
    "BackupPath": "/var/opt/mssql/backup/AW_Origin_baseline.bak",
    "Backup": {
      "ServerPath": "",
      "SharePath": "",
      "ImportFile": "",
      "ImportDir": "../../.data/import",
      "ImportContainerDir": "/var/opt/mssql/import",
      "DeleteAfterRestore": true
    },
    "OriginLockTimeoutMs": 10000,
    "ManifestPath": ".data/aw-baseline/manifest.json",
    "PreviewStoreDir": ".data/previews",
    "ExecuteAsUser": "dbr_preview_user",
    "ApplyCommandTimeoutSeconds": 60,
    "ApplyToolTimeoutSeconds": 600,
    "OriginSnapshotSuffix": "_pre",
    "ForceKeyset": false,
    "AllowRiskyDdlTriggers": false
  }
}
