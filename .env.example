# 복사해서 .env로 저장 후 값을 채운다. .env는 커밋하지 않는다.
# SA 비밀번호: 8자 이상, 대소문자·숫자·기호 중 3종 이상. 자리표시자를 반드시 바꾼다.
# $는 쓰지 않는다(compose가 .env 값을 보간한다). 공백·#이 들어가면 값을 따옴표로 감싼다.
MSSQL_SA_PASSWORD=<여기에-강한-비밀번호>
# 호스트 포트(127.0.0.1에만 바인딩)
MSSQL_HOST_PORT=14333
# 에디션: EnterpriseDeveloper(기본) 또는 Developer(SP0 재확인용)
MSSQL_PID=EnterpriseDeveloper
# 이미지 태그(2025 CU10, 조회일은 docs/dev-setup.md)
MSSQL_IMAGE_TAG=2025-CU10-ubuntu-24.04
