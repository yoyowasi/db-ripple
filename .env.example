# 복사해서 .env로 저장 후 값을 채운다. .env는 커밋하지 않는다.
# SA 비밀번호: 8자 이상, 대소문자·숫자·기호 중 3종 이상. 자리표시자를 반드시 바꾼다.
# $는 쓰지 않는다(compose가 .env 값을 보간한다). 공백·#이 들어가면 값을 따옴표로 감싼다.
MSSQL_SA_PASSWORD=<여기에-강한-비밀번호>
# 호스트 포트(127.0.0.1에만 바인딩)
MSSQL_HOST_PORT=14333
# 에디션: EnterpriseDeveloper(기본) 또는 Developer(SP0 재확인용)
MSSQL_PID=EnterpriseDeveloper
# 이미지 태그(2025 CU10, 조회일은 docs/dev-setup.md)
MSSQL_IMAGE_TAG=2025-CU10-ubuntu-24.04
# 서버 정렬(컨테이너를 처음 만들 때만 정해진다). Split이면 원본 서버 정렬과 같게. 예: Korean_Wansung_CI_AS
# MSSQL_COLLATION=

# --- Split(원본 서버 + 내 PC 샌드박스) 개발용: . .\scripts\env.ps1 -Split 이 읽는다(실행 파일은 화면의 설정을 쓴다) ---
# 원본 서버(예: dev-sql.corp,1433)
# ORIGIN_SQL_SERVER=
# 원본 SQL 인증 사용자(비우면 Windows 인증)
# ORIGIN_SQL_USER=
# 원본 비밀번호(비우면 env.ps1이 화면에 안 보이게 묻는다). 가능하면 비워 둔다
# ORIGIN_SQL_PASSWORD=
# true면 원본 서버 인증서를 검증 없이 믿는다(사내 자체 서명 인증서일 때만)
# ORIGIN_SQL_TRUST_CERT=
# 샌드박스 연결 언어(원본 로그인 언어와 맞출 때, 예: Korean)
# SANDBOX_SQL_LANGUAGE=

# --- 원본 서버 모사 컨테이너(compose profile origin, 집 테스트 SP17~SP21용). 기본값은 compose.yaml에 있다 ---
# 원본 컨테이너 이미지 태그(기본 2022-latest)
# ORIGIN_IMAGE_TAG=
# 원본 컨테이너 호스트 포트(127.0.0.1에만 바인딩, 기본 14334)
# ORIGIN_HOST_PORT=
# 원본 컨테이너 백업 폴더(호스트 경로, 기본 ./.data/origin-backup). 가져오기 폴더(.data/import)와 다른 곳으로 둔다
# ORIGIN_BACKUP_DIR=
